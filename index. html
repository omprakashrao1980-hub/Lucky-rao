<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Saint Sofia English School</title>

<style>

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f6ff;
    color: #222;
}

/* HEADER */
header {
    background: linear-gradient(135deg, #1565c0, #42a5f5);
    color: white;
    text-align: center;
    padding: 30px 15px;
}

.school-logo {
    width: 80px;
    height: 80px;
    margin: 0 auto 12px;
    background: white;
    color: #1565c0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    font-weight: bold;
}

header h1 {
    margin: 0;
    font-size: 26px;
}

header p {
    margin: 8px 0;
}

.tagline {
    font-size: 15px;
}

/* NAVIGATION */
nav {
    background: white;
    display: flex;
    justify-content: space-around;
    padding: 13px 3px;
    box-shadow: 0 2px 8px #ccc;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav a {
    text-decoration: none;
    color: #1565c0;
    font-weight: bold;
    font-size: 13px;
}

/* MAIN */
.container {
    padding: 18px;
}

.card {
    background: white;
    margin: 16px 0;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 3px 10px #d0d0d0;
}

.card h2 {
    color: #1565c0;
    margin-top: 0;
}

.welcome {
    text-align: center;
}

/* CLASSES */
.class-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.class-box {
    background: #e3f2fd;
    color: #1565c0;
    padding: 14px;
    text-align: center;
    border-radius: 10px;
    font-weight: bold;
}

/* NOTICE */
.notice {
    background: #fff8e1;
    border-left: 5px solid #ffb300;
    padding: 12px;
    border-radius: 8px;
}

/* TABLE */
table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    border: 1px solid #ddd;
    padding: 10px 5px;
    text-align: center;
}

th {
    background: #1565c0;
    color: white;
}

/* BUTTON */
.button {
    display: inline-block;
    background: #1565c0;
    color: white;
    padding: 12px 18px;
    border-radius: 8px;
    text-decoration: none;
    margin: 5px 2px;
}

/* FOOTER */
footer {
    background: #1565c0;
    color: white;
    text-align: center;
    padding: 18px;
    margin-top: 25px;
}

</style>
</head>

<body>

