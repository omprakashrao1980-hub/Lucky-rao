<section class="card">

    <h2>📍 Address</h2>

    <p>
        Manpur Shiv Charan Lane<br>
        (Manpur Aada), Gaya Ji
    </p>

</section>

</div>

<!-- FOOTER -->
<footer>

    © 2026 Saint Sofia English School

</footer>

</body>
</html>
